# ---- Supabase ----
# Public (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — NEVER prefix with NEXT_PUBLIC. Lives only in Vercel server env.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudflare Turnstile (bot protection on the public form) ----
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ---- Misc ----
# Salt used to hash submitter IPs for rate limiting (any long random string)
IP_HASH_SALT=
# Google review page URL shown on the thank-you screen
NEXT_PUBLIC_GOOGLE_REVIEW_URL=

# ---- Backups (used by GitHub Actions, not the app) ----
# SUPABASE_DB_URL=
